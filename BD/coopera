SELECT
	pk_id_humor,
	CASE
		WHEN humor_func = 1 THEN 'Muito ruim'
		WHEN humor_func = 2 THEN 'Ruim'
		WHEN humor_func = 3 THEN 'Mediano'
		WHEN humor_func = 4 THEN 'Bom'
		WHEN humor_func = 5 THEN 'Muito bom'
	END AS humor_descritivo
FROM HUMOR_FUNC;














